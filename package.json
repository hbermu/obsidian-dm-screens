{
  "name": "dm-screen",
  "version": "1.4.0",
  "description": "DM Screen - Obsidian plugin for D&D campaign management with player screen",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "deploy": "node esbuild.config.mjs production && cp main.js manifest.json styles.css ../../obsidian/calradia/.obsidian/plugins/dm-screen/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "obsidian",
    "dnd",
    "dm"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@playwright/test": "1.63.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "@vitest/coverage-v8": "^5.0.3",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "mocha": "^12.0.3",
    "obsidian": "latest",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wdio-obsidian-reporter": "^3.2.1",
    "wdio-obsidian-service": "^3.2.1",
    "webdriverio": "^9.32.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "ws": "^8.22.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "js-yaml": "^4.3.2",
    "ip-address": "^10.3.1",
    "nanoid": "^3.3.18",
    "deepmerge-ts": "^8.0.0",
    "diff": "^8.0.3",
    "moment": "^2.31.0"
  }
}
