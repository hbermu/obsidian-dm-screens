# Copy to .env and fill in. Never commit .env.

# Time zone for both containers' logs.
TZ=Etc/UTC

# Client API access key, 64 lowercase hex chars. Generate with:
#   openssl rand -hex 32
# Written into Hydrus on the first boot only; changing it later has no effect
# (add a new key from the GUI instead).
HYDRUS_API_KEY=

# Secret Hydrui signs its login sessions with. Generate with:
#   openssl rand -hex 32
HYDRUI_SECRET=
